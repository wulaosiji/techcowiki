{
  "name": "techcowiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GEO-first open encyclopedia of Chinese-founded technology companies.",
  "homepage": "https://techco.wiki",
  "license": "MIT AND CC-BY-SA-4.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "test": "vitest run",
    "check": "astro check && vitest run && npm run build && npm run harness",
    "harness": "node scripts/harness/verify-dist.mjs",
    "harness:host": "node scripts/harness/verify-host.mjs",
    "e2e": "node scripts/harness/e2e.mjs",
    "pages:upload": "node scripts/harness/pages-upload.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=techcowiki --commit-dirty=true"
  },
  "dependencies": {
    "astro": "^5.13.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
