---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SeeAlso from "../components/SeeAlso.astro";
import { allCompanies, allPeople, allProducts } from "../data/catalog";
import type { EditorialDoc } from "../data/pages";
import type { Locale } from "../data/types";
import { headingId, localePath, pick, t, tList } from "../lib/i18n";
import { ui } from "../data/site";
import { linkCatalogCopy } from "../lib/autolink";
import { renderCitedHtml } from "../lib/citations";
import { catalogNav, docNav } from "../lib/nav";
import { editorialGraph } from "../lib/schema";

interface Props {
  locale: Locale;
  doc: EditorialDoc;
}

const { locale, doc } = Astro.props;
const companies = allCompanies();
const people = allPeople();
const products = allProducts().map((product) => ({
  slug: product.slug,
  name: product.name.en,
  companySlug: product.companySlug,
}));
---

<BaseLayout
  locale={locale}
  title={t(doc.title, locale)}
  description={t(doc.description, locale)}
  path={`/${doc.slug}`}
  jsonLd={editorialGraph(locale, `/${doc.slug}`, t(doc.title, locale), t(doc.description, locale))}
>
  <div class="wrap">
    <Breadcrumbs
      locale={locale}
      items={[
        { href: localePath(locale, "/"), label: t(ui.home, locale) },
        { label: t(doc.title, locale) },
      ]}
    />
    <h1>{t(doc.title, locale)}</h1>
    <p class="lede">{t(doc.description, locale)}</p>
    <div class="prose">
      {doc.blocks.map((block) => (
        <section id={headingId(block.title.en)}>
          <h2>{t(block.title, locale)}</h2>
          {tList(block.body, locale).map((paragraph) => (
            <p set:html={renderCitedHtml(linkCatalogCopy(paragraph, locale, companies, people, {}, products), [])} />
          ))}
        </section>
      ))}
    </div>
    <SeeAlso
      locale={locale}
      groups={[
        { title: pick(locale, "Catalog", "目录"), links: catalogNav(locale) },
        { title: pick(locale, "Docs", "文档"), links: docNav(locale).filter((item) => item.href !== localePath(locale, `/${doc.slug}`)) },
      ]}
    />
  </div>
</BaseLayout>
