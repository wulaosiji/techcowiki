---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SeeAlso from "../components/SeeAlso.astro";
import { allCompanies, allPeople } from "../data/catalog";
import type { EditorialDoc } from "../data/pages";
import type { Locale } from "../data/types";
import { headingId, localePath, t } from "../lib/i18n";
import { ui } from "../data/site";
import { linkCatalogCopy } from "../lib/autolink";
import { renderCitedHtml } from "../lib/citations";
import { catalogNav, docNav } from "../lib/nav";

interface Props {
  locale: Locale;
  doc: EditorialDoc;
}

const { locale, doc } = Astro.props;
const companies = allCompanies();
const people = allPeople();
---

<BaseLayout
  locale={locale}
  title={t(doc.title, locale)}
  description={t(doc.description, locale)}
  path={`/${doc.slug}`}
>
  <div class="wrap">
    <Breadcrumbs
      locale={locale}
      items={[
        { href: localePath(locale, "/"), label: t(ui.home, locale) },
        { label: t(doc.title, locale) },
      ]}
    />
    <h1>{t(doc.title, locale)}</h1>
    <p class="lede">{t(doc.description, locale)}</p>
    <div class="prose">
      {doc.blocks.map((block) => (
        <section id={headingId(block.title.en)}>
          <h2>{t(block.title, locale)}</h2>
          {block.body[locale].map((paragraph) => (
            <p set:html={renderCitedHtml(linkCatalogCopy(paragraph, locale, companies, people), [])} />
          ))}
        </section>
      ))}
    </div>
    <SeeAlso
      locale={locale}
      groups={[
        { title: locale === "zh" ? "目录" : "Catalog", links: catalogNav(locale) },
        { title: locale === "zh" ? "文档" : "Docs", links: docNav(locale).filter((item) => item.href !== localePath(locale, `/${doc.slug}`)) },
      ]}
    />
  </div>
</BaseLayout>
