---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SeeAlso from "../components/SeeAlso.astro";
import { allCompanies, allPeople } from "../data/catalog";
import { faqs, ui } from "../data/site";
import type { Locale } from "../data/types";
import { linkCatalogCopy } from "../lib/autolink";
import { renderCitedHtml } from "../lib/citations";
import { localePath, pick, t } from "../lib/i18n";
import { catalogNav, docNav } from "../lib/nav";
import { faqGraph } from "../lib/schema";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const companies = allCompanies();
const people = allPeople();
---

<BaseLayout
  locale={locale}
  title={pick(locale, "FAQ", "常见问题")}
  description={pick(locale, "Frequently asked questions about TechCo.Wiki.", "关于 TechCo.Wiki 的常见问题。")}
  path="/faq"
  jsonLd={faqGraph(faqs, locale)}
>
  <div class="wrap">
    <Breadcrumbs
      locale={locale}
      items={[
        { href: localePath(locale, "/"), label: t(ui.home, locale) },
        { label: pick(locale, "FAQ", "常见问题")},
      ]}
    />
    <h1>{pick(locale, "Frequently asked questions", "常见问题")}</h1>
    {faqs.map((item) => (
      <section class="faq-item" id={item.id}>
        <h2>{t(item.question, locale)}</h2>
        <p set:html={renderCitedHtml(linkCatalogCopy(t(item.answer, locale), locale, companies, people), [])} />
      </section>
    ))}
    <SeeAlso
      locale={locale}
      groups={[
        { title: pick(locale, "Catalog", "目录"), links: catalogNav(locale) },
        { title: pick(locale, "Docs", "文档"), links: docNav(locale) },
      ]}
    />
  </div>
</BaseLayout>
