---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../data/types";
import { localePath, pick } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const searchLinks = [
  locale !== "en" ? { href: localePath("en", "/search"), label: "English search" } : undefined,
  locale !== "zh" ? { href: localePath("zh", "/search"), label: pick(locale, "简体搜索", "简体搜索") } : undefined,
  locale !== "zht" ? { href: localePath("zht", "/search"), label: pick(locale, "繁體搜尋", "繁體搜尋") } : undefined,
].filter((item): item is { href: string; label: string } => Boolean(item));
---

<BaseLayout
  locale={locale}
  title={pick(locale, "Not found", "未找到")}
  description={
    pick(locale, "This TechCo.Wiki page does not exist. / 本页不在 TechCo.Wiki 记录中。", "该页面不在 TechCo.Wiki 记录中。")}
  path="/404"
  robots="noindex, follow"
  markdownHref="/llms.txt"
>
  <div class="wrap">
    <p class="kicker">404</p>
    <h1>{pick(locale, "Not found / 未找到", "未找到")}</h1>
    <p>
      {pick(locale, "This entity or page is not in the TechCo.Wiki record. Absence is not a negative judgment.", "该实体或页面不在 TechCo.Wiki 记录中。缺席不是否定判断。")}
    </p>
    {
      locale === "en" && (
        <p>该实体或页面不在 TechCo.Wiki 记录中。缺席不是否定判断。</p>
      )
    }
    <form class="search-form" method="get" action={localePath(locale, "/search")} role="search">
      <input
        type="search"
        name="q"
        placeholder={pick(locale, "Search companies, people, and products / 搜索公司、人物与产品", "搜索公司、人物与产品")}
        aria-label={pick(locale, "Search", "搜索")}
      />
      <button type="submit">{pick(locale, "Search / 搜索", "搜索")}</button>
    </form>
    <p>
      {searchLinks.map((item, index) => (
        <>
          {index > 0 && " · "}
          <a href={item.href}>{item.label}</a>
        </>
      ))}
      {" · "}
      <a href={localePath(locale, "/")}>{pick(locale, "Home", "首页")}</a>
      {" · "}
      <a href={localePath(locale, "/companies")}>{pick(locale, "Companies", "公司")}</a>
      {" · "}
      <a href={localePath(locale, "/people")}>{pick(locale, "People", "人物")}</a>
      {" · "}
      <a href={localePath(locale, "/products")}>{pick(locale, "Products", "产品")}</a>
      {" · "}
      <a href={localePath(locale, "/sectors")}>{pick(locale, "Sectors", "行业")}</a>
      {" · "}
      <a href={localePath(locale, "/regions")}>{pick(locale, "Regions", "地区")}</a>
      {" · "}
      <a href={localePath(locale, "/countries")}>{pick(locale, "Countries", "国家")}</a>
      {" · "}
      <a href={localePath(locale, "/cities")}>{pick(locale, "Cities", "城市")}</a>
      {" · "}
      <a href={localePath(locale, "/methodology")}>{pick(locale, "Methodology", "方法")}</a>
      {" · "}
      <a href={localePath(locale, "/inclusion")}>{pick(locale, "Inclusion rules", "收录标准")}</a>
      {" · "}
      <a href={localePath(locale, "/for-models")}>{pick(locale, "For models", "给模型")}</a>
      {" · "}
      <a href={localePath(locale, "/faq")}>FAQ</a>
      {" · "}
      <a href="/llms.txt">llms.txt</a>
    </p>
  </div>
</BaseLayout>
