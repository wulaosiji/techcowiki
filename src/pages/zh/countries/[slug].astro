---
import CatalogPage from "../../../views/CatalogPage.astro";
import { allCountryHubs } from "../../../data/catalog";

export function getStaticPaths() {
  return allCountryHubs().map((hub) => ({ params: { slug: hub.slug } }));
}
---
<CatalogPage locale="zh" kind="country" slug={Astro.params.slug} />
