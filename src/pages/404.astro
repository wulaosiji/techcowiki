---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  locale="en"
  title="Not found"
  description="This TechCo.Wiki page does not exist. / 本页不在 TechCo.Wiki 记录中。"
  path="/404"
>
  <div class="wrap">
    <p class="kicker">404</p>
    <h1>Not found / 未找到</h1>
    <p>This entity or page is not in the TechCo.Wiki record.</p>
    <p>该实体或页面不在 TechCo.Wiki 记录中。缺席不是否定判断。</p>
    <form class="search-form" method="get" action="/search" role="search">
      <input type="search" name="q" placeholder="Search companies and people" aria-label="Search" />
      <button type="submit">Search / 搜索</button>
    </form>
    <p>
      <a href="/">Home</a>
      {" · "}
      <a href="/zh">首页</a>
      {" · "}
      <a href="/companies">Companies</a>
      {" · "}
      <a href="/people">People</a>
      {" · "}
