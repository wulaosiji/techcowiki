---
import type { Locale } from "../data/types";

interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  locale: Locale;
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label={Astro.props.locale === "zh" ? "面包屑" : "Breadcrumb"}>
  <ol>
    {items.map((item) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
