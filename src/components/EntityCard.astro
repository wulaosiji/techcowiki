---
import { getCompany } from "../data/catalog";
import { citySlug, countrySlug } from "../data/places";
import { sectors } from "../data/site";
import type { CatalogProduct, Company, Locale, Person } from "../data/types";
import { altName, localePath, t } from "../lib/i18n";
import { clipPlain, stripCitations } from "../lib/citations";

interface Props {
  locale: Locale;
  company?: Company;
  person?: Person;
  product?: CatalogProduct;
}

const { locale, company, person, product } = Astro.props;
const publisher = product ? getCompany(product.companySlug) : undefined;
const href = company
  ? localePath(locale, `/companies/${company.slug}`)
  : product
    ? localePath(locale, `/products/${product.slug}`)
    : localePath(locale, `/people/${person!.slug}`);
const name = company
  ? t(company.name, locale)
  : product
    ? t(product.name, locale)
    : t(person!.name, locale);
const sub = company
  ? altName(company.name, locale)
  : product
    ? publisher
      ? t(publisher.name, locale)
      : altName(product.name, locale)
    : altName(person!.name, locale);
const text = product
  ? clipPlain(t(product.definition, locale), 160)
  : stripCitations(
      company ? t(company.definition, locale) : t(person!.definition, locale),
    );
const chipCompany = company ?? publisher;
const entityType = company ? "company" : product ? "product" : "person";
const entityId = company?.id ?? product?.id ?? person!.id;
const entitySlug = company?.slug ?? product?.slug ?? person!.slug;
---

<article class="card">
  <a
    class="card-main"
    href={href}
    data-astro-prefetch="hover"
    data-entity-type={entityType}
    data-entity-id={entityId}
    data-entity-slug={entitySlug}
  >
    <div class="name">{name}</div>
    <div class="sub">{sub}</div>
    <p>{text}</p>
  </a>
  {chipCompany && (
    <div class="chips">
      {chipCompany.sectors.slice(0, 2).map((slug) => (
        <a class="chip" href={localePath(locale, `/sectors/${slug}`)}>
          {(() => {
            const sector = sectors.find((item) => item.slug === slug);
            return sector ? t(sector.name, locale) : slug;
          })()}
        </a>
      ))}
      <a class="chip" href={localePath(locale, `/cities/${citySlug(chipCompany.headquarters.city.en)}`)}>
        {t(chipCompany.headquarters.city, locale)}
      </a>
      <a class="chip" href={localePath(locale, `/countries/${countrySlug(chipCompany.headquarters.countryCode)}`)}>
        {t(chipCompany.headquarters.country, locale)}
      </a>
    </div>
  )}
</article>
