---
import { citySlug, countrySlug } from "../data/places";
import { sectors } from "../data/site";
import type { Company, Locale, Person } from "../data/types";
import { altName, localePath, t } from "../lib/i18n";
import { stripCitations } from "../lib/citations";

interface Props {
  locale: Locale;
  company?: Company;
  person?: Person;
}

const { locale, company, person } = Astro.props;
const href = company
  ? localePath(locale, `/companies/${company.slug}`)
  : localePath(locale, `/people/${person!.slug}`);
const entity = company ?? person!;
const name = t(entity.name, locale);
const sub = altName(entity.name, locale);
const text = stripCitations(t(entity.definition, locale));
---

<article class="card">
  <a class="card-main" href={href} data-astro-prefetch="hover">
    <div class="name">{name}</div>
    <div class="sub">{sub}</div>
    <p>{text}</p>
  </a>
  {company && (
    <div class="chips">
      {company.sectors.slice(0, 2).map((slug) => (
        <a class="chip" href={localePath(locale, `/sectors/${slug}`)}>
          {(() => {
            const sector = sectors.find((item) => item.slug === slug);
            return sector ? t(sector.name, locale) : slug;
          })()}
        </a>
      ))}
      <a class="chip" href={localePath(locale, `/cities/${citySlug(company.headquarters.city.en)}`)}>
        {t(company.headquarters.city, locale)}
      </a>
      <a class="chip" href={localePath(locale, `/countries/${countrySlug(company.headquarters.countryCode)}`)}>
        {t(company.headquarters.country, locale)}
      </a>
    </div>
  )}
</article>
